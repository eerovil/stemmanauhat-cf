{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rehearse",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // The site's addresses. WORKER_HOST is "<name>.<your subdomain>.workers.dev";
  // CI's live check and scripts/set-worker-secrets.sh read it from here.
  // PUBLIC_HOST is optional: a name of your own that a proxy forwards to
  // WORKER_HOST (this copy's VPS). Leave it out if there is none.
  "vars": {
    "WORKER_HOST": "rehearse.joyweshare.org"
  },

  // JoyWeShare Rehearse answers at this name directly: a Cloudflare custom
  // domain on the joyweshare.org zone, whose DNS record and certificate
  // Cloudflare makes itself. No proxy, so no PUBLIC_HOST.
  "routes": [{ "pattern": "rehearse.joyweshare.org", "custom_domain": true }],

  // The Vue front end, built by `vite build`. The Worker runs first on every
  // request so that pages, files and the old ?user= links all pass its access
  // check; it hands everything else to the assets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stemmanauhat",
      // Written by scripts/cloudflare-setup.sh. Not a secret.
      "database_id": "b846d799-f829-4bfc-85a1-1cd28c6d0590",
      "migrations_dir": "migrations"
    }
  ],

  // Song files, written by song-app. Never public: the Worker serves them after
  // the same access check as the pages.
  "r2_buckets": [{ "binding": "SONGS", "bucket_name": "stemmanauhat" }]

  // Secrets (wrangler secret put): SESSION_SECRET, GOOGLE_CLIENT_ID,
  // GOOGLE_CLIENT_SECRET. Tests alone also set GOOGLE_AUTH_URL and
  // GOOGLE_TOKEN_URL, pointing at tests/support/fake-google.mjs.
}
